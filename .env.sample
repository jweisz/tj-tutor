# Copy this file to .env and fill in your key. .env is gitignored -- never commit it.
# Only needed if you run with --provider anthropic (Ollama needs no key).
ANTHROPIC_API_KEY=sk-ant-...

# Only needed with provider = "lmstudio" when the LM Studio / llmster server has
# "Require Authentication" turned on. Create a token in LM Studio's Server Settings.
# LM_API_TOKEN=...
